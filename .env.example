# =============================================================================
# GetSite OS — переменные окружения
# Скопируйте в .env локально или задайте в Railway → Variables.
# Значения (ключи) подставьте сами.
# =============================================================================

# --- Обязательные для продакшена ---

# Секрет подписи cookie-сессий (длинная случайная строка)
SESSION_SECRET=

# PostgreSQL connection string (обязательно в production)
# На Railway используйте только приватную сеть:
#   DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
DATABASE_URL=

# --- Опциональные (алиасы / совместимость) ---

# Если Railway отдаёт приватный URL отдельной переменной
DATABASE_PRIVATE_URL=

# Альтернативное имя (некоторые шаблоны Postgres)
POSTGRES_URL=

# Для публичного PostgreSQL обязателен проверяемый CA. Railway private URL
# определяется автоматически и работает внутри приватной сети без TLS.
DATABASE_SSL=
DATABASE_CA=

# Порт HTTP (на Railway задаётся автоматически)
PORT=

# production | development
# В production обязательны SESSION_SECRET и DATABASE_URL.
NODE_ENV=

# --- Bootstrap-пользователи ---
# Пароль должен быть уникальным и не короче 12 символов.
# __SET_ME__ и пустое значение НЕ создают/НЕ перезаписывают пользователя.
AUTH_DENIS_EMAIL=denis@getsite.uz
AUTH_DENIS_PASSWORD=__SET_ME__
AUTH_NIKITA_EMAIL=nikita@getsite.uz
AUTH_NIKITA_PASSWORD=__SET_ME__
AUTH_MANAGER_EMAIL=manager@getsite.uz
AUTH_MANAGER_PASSWORD=__SET_ME__
AUTH_DESIGNER_EMAIL=designer@getsite.uz
AUTH_DESIGNER_PASSWORD=__SET_ME__

# Только для локальной разработки: разрешает известные тестовые аккаунты
# при первой инициализации пустой БД. Никогда не включать в production.
ALLOW_DEV_BOOTSTRAP=0

# Подробный чеклист деплоя: см. DEPLOY.md и railway.toml

